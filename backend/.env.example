# Database
DATABASE_URL="postgresql://postara:postara_dev_password@localhost:5432/postara"
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL="redis://:postara_redis_password@localhost:6379"

# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# Email Service Provider (choose one)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Alternative: AWS SES
# EMAIL_PROVIDER=ses
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=your_access_key
# AWS_SES_SECRET_KEY=your_secret_key

# Alternative: Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key

# AI Service (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Social Media APIs
# Twitter/X
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_CALLBACK_URL=http://localhost:3001/api/v1/social/twitter/callback

# Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/social/facebook/callback

# Instagram
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_CALLBACK_URL=http://localhost:3001/api/v1/social/instagram/callback

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/v1/social/linkedin/callback

# Payment (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Storage (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER=s3
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your_access_key
AWS_S3_SECRET_KEY=your_secret_key

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
