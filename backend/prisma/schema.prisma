// Prisma Schema for Postara Marketing Automation Platform
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  password      String? // Hashed password
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  workspaces       WorkspaceMember[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  sessions         Session[]
  accounts         Account[]
  aiGenerations    AIGeneration[]
  contentLibrary   ContentLibrary[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// WORKSPACES & TEAMS
// ============================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          WorkspaceMember[]
  subscription     Subscription?
  emailLists       EmailList[]
  campaigns        Campaign[]
  socialAccounts   SocialAccount[]
  socialPosts      SocialPost[]
  contentLibrary   ContentLibrary[]
  webhooks         Webhook[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String             @unique @map("workspace_id")
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(TRIAL)
  stripeCustomerId   String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  stripePriceId      String?            @map("stripe_price_id")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageRecords  UsageRecord[]

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model UsageRecord {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  type           UsageType
  count          Int      @default(0)
  month          DateTime
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, type, month])
  @@map("usage_records")
}

enum UsageType {
  EMAIL_SUBSCRIBERS
  EMAILS_SENT
  SOCIAL_POSTS
  AI_GENERATIONS
}

// ============================================
// EMAIL NEWSLETTER SYSTEM
// ============================================

model EmailList {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscribers Subscriber[]
  campaigns   Campaign[]

  @@map("email_lists")
}

model Subscriber {
  id          String           @id @default(cuid())
  listId      String           @map("list_id")
  email       String
  firstName   String?          @map("first_name")
  lastName    String?          @map("last_name")
  status      SubscriberStatus @default(PENDING)
  tags        String[]
  customFields Json?           @map("custom_fields")
  subscribedAt DateTime?       @map("subscribed_at")
  unsubscribedAt DateTime?     @map("unsubscribed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  list              EmailList           @relation(fields: [listId], references: [id], onDelete: Cascade)
  campaignAnalytics CampaignAnalytics[]

  @@unique([listId, email])
  @@index([email])
  @@map("subscribers")
}

enum SubscriberStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  listId      String         @map("list_id")
  name        String
  subject     String
  preheader   String?
  fromName    String         @map("from_name")
  fromEmail   String         @map("from_email")
  replyTo     String?        @map("reply_to")
  content     String         @db.Text
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?      @map("scheduled_at")
  sentAt      DateTime?      @map("sent_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list       EmailList           @relation(fields: [listId], references: [id], onDelete: Cascade)
  analytics  CampaignAnalytics[]

  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELED
}

model CampaignAnalytics {
  id           String    @id @default(cuid())
  campaignId   String    @map("campaign_id")
  subscriberId String    @map("subscriber_id")
  sent         Boolean   @default(false)
  delivered    Boolean   @default(false)
  opened       Boolean   @default(false)
  clicked      Boolean   @default(false)
  bounced      Boolean   @default(false)
  complained   Boolean   @default(false)
  unsubscribed Boolean   @default(false)
  openedAt     DateTime? @map("opened_at")
  clickedAt    DateTime? @map("clicked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@map("campaign_analytics")
}

// ============================================
// SOCIAL MEDIA SCHEDULER
// ============================================

model SocialAccount {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  platform    SocialPlatform
  accountId   String             @map("account_id")
  accountName String             @map("account_name")
  username    String?
  avatar      String?
  accessToken String             @map("access_token") @db.Text
  refreshToken String?           @map("refresh_token") @db.Text
  expiresAt   DateTime?          @map("expires_at")
  status      SocialAccountStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     SocialPost[]
  analytics SocialAnalytics[]

  @@unique([platform, accountId])
  @@map("social_accounts")
}

enum SocialPlatform {
  TWITTER
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model SocialPost {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  accountId   String           @map("account_id")
  content     String           @db.Text
  mediaUrls   String[]         @map("media_urls")
  status      SocialPostStatus @default(DRAFT)
  scheduledAt DateTime?        @map("scheduled_at")
  publishedAt DateTime?        @map("published_at")
  platformPostId String?       @unique @map("platform_post_id")
  errorMessage String?         @map("error_message")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  analytics SocialAnalytics[]

  @@map("social_posts")
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  DELETED
}

model SocialAnalytics {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  accountId String   @map("account_id")
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  views     Int      @default(0)
  clicks    Int      @default(0)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  post    SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("social_analytics")
}

// ============================================
// AI CONTENT GENERATOR
// ============================================

model AIGeneration {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  type        AIContentType
  prompt      String           @db.Text
  content     String           @db.Text
  model       String           @default("gpt-4")
  tokens      Int              @default(0)
  status      AIGenerationStatus @default(COMPLETED)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_generations")
}

enum AIContentType {
  EMAIL_SUBJECT
  EMAIL_BODY
  SOCIAL_POST
  BLOG_OUTLINE
  BLOG_POST
  REPURPOSE
}

enum AIGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ContentLibrary {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  title       String
  content     String        @db.Text
  type        ContentType
  tags        String[]
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("content_library")
}

enum ContentType {
  EMAIL
  SOCIAL
  BLOG
  TEMPLATE
  SNIPPET
}

// ============================================
// WEBHOOKS & INTEGRATIONS
// ============================================

model Webhook {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  name        String
  url         String
  events      String[]
  secret      String
  status      WebhookStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs      WebhookLog[]

  @@map("webhooks")
}

enum WebhookStatus {
  ACTIVE
  PAUSED
  FAILED
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String   @map("webhook_id")
  event      String
  payload    Json
  response   Json?
  statusCode Int?     @map("status_code")
  success    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_logs")
}
