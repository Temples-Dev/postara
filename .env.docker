# Docker Environment Variables
# Copy this file to .env for local development with Docker

# Node Environment
NODE_ENV=development

# PostgreSQL Configuration
POSTGRES_USER=postara
POSTGRES_PASSWORD=postara_dev_password
POSTGRES_DB=postara
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=postara_redis_password
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=3001
DATABASE_URL=postgresql://postara:postara_dev_password@postgres:5432/postara?schema=public
REDIS_URL=redis://:postara_redis_password@redis:6379

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Development Tools
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081

# Email Service (Add your keys)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# AI Service (Add your keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Social Media APIs (Add your keys)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Payment (Add your keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage (Add your keys)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# Monitoring
SENTRY_DSN=
